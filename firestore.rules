rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    // Devuelve el rol guardado en usuarios/{uid}, o null si el perfil no
    // existe (así ninguna regla se rompe por un perfil faltante).
    function rolDe(uid) {
      return exists(/databases/$(database)/documents/usuarios/$(uid))
        ? get(/databases/$(database)/documents/usuarios/$(uid)).data.rol
        : null;
    }

    function esAdmin() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'admin';
    }

    // Personal con acceso. Un admin puede desactivar una cuenta dejándola
    // en rol 'pendiente'.
    function esPersonal() {
      return estaAutenticado() && rolDe(request.auth.uid) in ['admin', 'vendedor'];
    }

    // Documento con el código de invitación vigente: config/registro
    // { codigo: '...' }. Se crea a mano en la consola; los clientes no
    // pueden leerlo ni escribirlo (solo estas reglas lo consultan).
    match /config/{documento} {
      allow read, write: if false;
    }

    match /usuarios/{uid} {
      allow read: if (estaAutenticado() && request.auth.uid == uid) || esAdmin();

      allow create:
        // Auto-registro: solo el propio perfil, siempre como 'vendedor'
        // (nunca 'admin'), con exactamente estos campos y el código de
        // invitación correcto.
        if (estaAutenticado()
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['nombre', 'usuario', 'rol', 'codigoInvitacion'])
            && request.resource.data.rol == 'vendedor'
            && request.resource.data.codigoInvitacion is string
            && request.resource.data.codigoInvitacion ==
               get(/databases/$(database)/documents/config/registro).data.codigo)
        // Restablecimiento de contraseña: un admin crea el perfil de otra
        // persona en su acceso nuevo, marcado para que elija su contraseña.
        || (esAdmin()
            && request.auth.uid != uid
            && request.resource.data.keys().hasOnly(['nombre', 'usuario', 'rol', 'debeCambiarClave'])
            && request.resource.data.rol in ['admin', 'vendedor', 'pendiente']
            && request.resource.data.debeCambiarClave == true);

      allow update:
        // Solo un admin cambia roles, solo el campo rol, solo a valores
        // válidos, y no el suyo propio (evita quedarse sin admins).
        if (esAdmin()
            && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol'])
            && request.resource.data.rol in ['admin', 'vendedor', 'pendiente'])
        // Quien entró con una contraseña temporal solo puede bajar su propia
        // marca de "debe cambiar la contraseña".
        || (estaAutenticado()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['debeCambiarClave'])
            && request.resource.data.debeCambiarClave == false);

      allow delete: if esAdmin() && request.auth.uid != uid;
    }

    // Generación de acceso de cada usuario (accesos/{usuario} { gen: N }).
    // El login la consulta antes de autenticarse, por eso se puede leer un
    // documento suelto sin sesión (no se puede listar). Solo tiene un número:
    // ningún dato personal. Solo un admin la escribe, al restablecer una
    // contraseña.
    match /accesos/{usuario} {
      allow get: if true;
      allow list: if false;
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['gen'])
        && request.resource.data.gen is int
        && request.resource.data.gen >= 2
        && request.resource.data.gen <= 99;
      allow delete: if false;
    }

    match /sucursales/{sucursalId} {
      allow read: if esPersonal();
      allow create, update, delete: if esAdmin();
    }

    match /productos/{productoId} {
      allow read, create: if esPersonal();
      allow delete: if esAdmin();
      allow update: if esAdmin() ||
        (esPersonal() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockPorSucursal']));
    }

    // Historial de ajustes manuales de stock: cualquiera del personal puede
    // registrar el suyo, solo un admin lo consulta y nadie lo edita ni borra.
    match /movimientosStock/{movimientoId} {
      allow create: if esPersonal()
        && request.resource.data.usuarioUid == request.auth.uid;
      allow read: if esAdmin();
      allow update, delete: if false;
    }

    // En ventas y turnos, esAdmin() va primero: el admin lee rangos enteros
    // sin filtrar por vendedor, y así la consulta se aprueba sin depender de
    // resource.data.
    match /ventas/{ventaId} {
      // Una venta nueva: propia, con la fecha del servidor (no se puede
      // retrasar), dentro de un turno propio que siga abierto, y solo con los
      // campos que escribe la app.
      allow create: if esPersonal()
        && request.resource.data.keys().hasOnly([
          'fecha', 'turnoId', 'sucursalId', 'total', 'metodoPago', 'vuelto',
          'montoEfectivo', 'vendedorUid', 'vendedorNombre', 'clienteId',
          'clienteNombre', 'items'
        ])
        && request.resource.data.vendedorUid == request.auth.uid
        && request.resource.data.fecha == request.time
        && get(/databases/$(database)/documents/turnos/$(request.resource.data.turnoId)).data.vendedorUid == request.auth.uid
        && get(/databases/$(database)/documents/turnos/$(request.resource.data.turnoId)).data.estado == 'abierto';

      allow read: if esAdmin()
        || (esPersonal() && resource.data.vendedorUid == request.auth.uid);

      // Un vendedor solo puede anular su propia venta, una vez, y mientras
      // su turno siga abierto: nunca cambiar montos, productos ni método de
      // pago. Corregir una venta (cambiar producto) es cosa del admin.
      allow update: if esAdmin()
        || (esPersonal()
            && resource.data.vendedorUid == request.auth.uid
            && resource.data.get('cancelada', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelada', 'fechaCancelacion'])
            && request.resource.data.cancelada == true
            && get(/databases/$(database)/documents/turnos/$(resource.data.turnoId)).data.estado == 'abierto');

      allow delete: if esAdmin();
    }

    match /turnos/{turnoId} {
      // Un turno nace abierto y solo con los campos de la apertura.
      allow create: if esPersonal()
        && request.resource.data.keys().hasOnly([
          'estado', 'sucursalId', 'fechaApertura', 'vendedorUid',
          'vendedorNombre', 'montoInicial', 'billetesApertura', 'monedasApertura'
        ])
        && request.resource.data.vendedorUid == request.auth.uid
        && request.resource.data.estado == 'abierto';

      allow read: if esAdmin()
        || (esPersonal() && resource.data.vendedorUid == request.auth.uid);

      // El vendedor solo puede cerrar su turno abierto, escribiendo los
      // campos del cierre. Un turno cerrado (o el monto inicial) ya no se
      // puede tocar.
      allow update: if esAdmin()
        || (esPersonal()
            && resource.data.vendedorUid == request.auth.uid
            && resource.data.estado == 'abierto'
            && request.resource.data.estado == 'cerrado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'estado', 'fechaCierre', 'totalVentas', 'totalEfectivoVentas',
              'totalTarjeta', 'totalCredito', 'efectivoEsperado',
              'billetesCierre', 'monedasCierre', 'totalContado', 'diferencia'
            ]));

      allow delete: if esAdmin();
    }

    match /clientes/{clienteId} {
      allow read: if esPersonal();

      // Un cliente nuevo siempre parte sin deuda.
      allow create: if esPersonal()
        && request.resource.data.deuda == 0;

      // El vendedor solo mueve la deuda (venta a crédito, cancelación,
      // abono), sin dejarla negativa y sin subirla por encima del límite de
      // crédito del cliente. Bajarla siempre se permite (abonos).
      allow update: if esAdmin()
        || (esPersonal()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deuda'])
            && request.resource.data.deuda is number
            && request.resource.data.deuda >= 0
            && (request.resource.data.deuda <= resource.data.deuda
                || request.resource.data.deuda <= resource.data.get('limiteCredito', 0)));

      allow delete: if esAdmin();
    }
  }
}
